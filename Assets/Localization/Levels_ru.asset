  m_SharedData: {fileID: 11400000, guid: aab49e8334510db45a6b4280d47c74ce, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 12754542592
    m_Localized: "\u0423\u0440 1. \u0427\u0435\u0440\u0441\u0442\u0432\u044B\u0439
      \u0445\u043B\u0435\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 35772882944
    m_Localized: "\u041C\u044B \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u043C\u044B\u0448\u043A\u0438.
      \u0412\u043E\u0442 \u0431\u044B \u043D\u0430\u0439\u0442\u0438 \u0445\u043E\u0442\u044C
      \u043A\u0440\u043E\u0448\u043A\u0443 \u0445\u043B\u0435\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 55427773161472
    m_Localized: "\u0423\u0440 2. \u0422\u044B\u0431\u043B\u043E\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 55437331980288
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u044B \u0441\u044B\u0442\u044B\u0435,
      \u043D\u043E \u0437\u0430\u043A\u0443\u0441\u0438\u0442\u044C \u044F\u0431\u043B\u043E\u0447\u043A\u043E\u043C
      \u043D\u0435 \u043E\u0442\u043A\u0430\u0436\u0435\u043C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 55441320763392
    m_Localized: "\u0423\u0440 3. \u042F\u0434\u0440\u0451\u043D\u044B\u0439 \u043B\u0443\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 55443283697664
    m_Localized: "\u0410 \u0432\u043E\u0442 \u043B\u0443\u043A, \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043B\u044C\u044E\u0442\u0441\u044F \u0440\u0435\u043A\u0438 \u0441\u043B\u0451\u0437.
      \u0427\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u043B\u0430\u043A\u0430\u0442\u044C
      \u0435\u0433\u043E \u0442\u043E\u0436\u0435 \u043D\u0430\u0434\u043E \u0441\u044A\u0435\u0441\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 55447226343424
    m_Localized: "\u0421\u043B\u044B\u0448\u0430\u043B, \u0447\u0442\u043E \u043A\u0430\u043F\u0443\u0441\u0442\u0430,
      \u043E\u043D\u0430 \u0436\u0435 \u0437\u0435\u043B\u0435\u043D\u044C, \xAB\u0432\u0430\u0449\u0435\xBB
      \u0440\u0435\u0448\u0430\u0435\u0442 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C. \u0422\u0430\u043A \u0447\u0442\u043E
      \u0437\u0430\u043F\u0430\u0441\u0451\u043C\u0441\u044F, \u043D\u0430 \u0432\u0441\u044F\u043A\u0438\u0439
      \u0441\u043B\u0443\u0447\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 55445217271808
    m_Localized: "\u0423\u0440 4. \u0427\u0438\u0441\u0442\u043E \u043A\u0430\u043F\u0443\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 55450313351168
    m_Localized: "\u0412 \u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0435 \u043C\u043D\u043E\u0433\u043E
      \u0432\u0438\u0442\u0430\u043C\u0438\u043D\u0430 \xAB\u0410\xBB. \u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
      \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0439 \u0432\u0438\u0442\u0430\u043C\u0438\u043D!
      \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u043C\u0441\u044F
      \u043E \u0441\u0432\u043E\u0451\u043C \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 55449038282752
    m_Localized: "\u0423\u0440 5. \u0412\u0438\u0442\u0430\u043C\u0438\u043D\u043D\u0430\u044F
      \u043C\u043E\u0440\u043A\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 55452796379136
    m_Localized: "\u041C\u044B \u043D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D\u044B,
      \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u044B\u0435 \u043B\u0438 \u044D\u0442\u043E
      \u0433\u0440\u0438\u0431\u044B. \u041D\u043E \u0435\u0441\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0434\u0438\u043D \u0441\u043F\u043E\u0441\u043E\u0431 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C.
      \u041F\u0440\u043E\u0432\u0435\u0434\u0451\u043C \u043D\u0430\u0443\u0447\u043D\u044B\u0439
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 55451554865152
    m_Localized: "\u0423\u0440 6. \u041D\u0435 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0433\u0440\u0438\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 55455245852672
    m_Localized: "\u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u044D\u0442\u0430 \u043C\u0438\u0441\u043A\u0430 \u043E\u0433\u0443\u0440\u0446\u043E\u0432
      \u043F\u043B\u043E\u0445\u043E \u043D\u0430 \u043D\u0430\u0441 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430.
      \u041D\u0430\u0440\u043E\u0434, \u043F\u043E\u0439\u0434\u0451\u043C \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u043C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 55454469906432
    m_Localized: "\u0423\u0440 7. \u041C\u0438\u0441\u043A\u0430 \u043E\u0441\u0443\u0436\u0434\u0430\u044E\u0449\u0438\u0445
      \u043E\u0433\u0443\u0440\u0446\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 55456822910976
    m_Localized: "\u0412 \u043C\u044F\u0441\u0435 \u0437\u0430\u0441\u0442\u0440\u044F\u043B
      \u043C\u044B\u0448\u044C-\u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A.
      \u0415\u0441\u0442\u044C \u0434\u0432\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u0430
      \u0435\u0433\u043E \u0432\u044B\u0442\u0430\u0449\u0438\u0442\u044C: \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
      \u0438 \u0431\u044B\u0441\u0442\u0440\u043E. \u0411\u0440\u0430\u0442\u0430\u043D,
      \u043C\u044B \u0443\u0436\u0435 \u0441\u043F\u0435\u0448\u0438\u043C, \u0434\u0435\u0440\u0436\u0438\u0441\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 55455984050176
    m_Localized: "\u0423\u0440 8. \u041C\u044F\u0441\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 55458399969280
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0432\u0438\u043D\u043E\u0433\u0440\u0430\u0434
      - \u044D\u0442\u043E \u0431\u0443\u0434\u0443\u0449\u0435\u0435 \u0432\u0438\u043D\u043E.
      \u0410 \u043C\u044B \u043F\u0440\u043E\u0442\u0438\u0432 \u043F\u044C\u044F\u043D\u0441\u0442\u0432\u0430!
      \u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0441\u044A\u0435\u0441\u0442\u044C
      \u0435\u0433\u043E \u0441\u0435\u0439\u0447\u0430\u0441, \u043F\u043E\u043A\u0430
      \u043E\u043D \u0435\u0449\u0451 \u043D\u0435 \u043F\u043E\u043A\u0440\u044B\u043B\u0441\u044F
      \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u043E\u0439 \u0431\u0443\u0442\u044B\u043B\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 55457661771776
    m_Localized: "\u0423\u0440 9. \u0412\u0438\u043D\u043E\u0433\u0440\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 55460010582016
    m_Localized: "\u041C\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u043E\u044F\u043B\u0438\u0441\u044C
      \u044D\u0442\u0438\u0445 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0445 \u0442\u044B\u043A\u0432!
      \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0432 \u0425\u044D\u043B\u043B\u043E\u0443\u0438\u043D.
      \u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u044B \u0433\u043E\u0442\u043E\u0432\u044B
      \u0434\u0430\u0442\u044C \u0431\u043E\u0439 \u043D\u0430\u0448\u0438\u043C
      \u0441\u0442\u0440\u0430\u0445\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 55459205275648
    m_Localized: "\u0423\u0440 10. \u0421\u0442\u0440\u0430\u0448\u043D\u0430\u044F
      \u0442\u044B\u043A\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 55461788966912
    m_Localized: "\u041E\u0442 \u0437\u0430\u043F\u0430\u0445\u0430 \u044D\u0442\u043E\u0433\u043E
      \u0441\u044B\u0440\u0430 \u043E\u0431\u043E\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0441\u043F\u043E\u043B\u0437\u0430\u0442\u044C \u0441\u043E \u0441\u0442\u0435\u043D,
      \u043D\u0430\u0434\u043E \u0441\u0440\u043E\u0447\u043D\u043E \u0435\u0433\u043E
      \u0441\u044A\u0435\u0441\u0442\u044C, \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0430\u0441\u0442\u0438
      \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 55460853637120
    m_Localized: "\u0423\u0440 11. \u0410\u0440\u043E\u043C\u0430\u0442\u043D\u044B\u0439
      \u0441\u044B\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 55464238440448
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0447\u0442\u043E
      \u0435\u0441\u043B\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0434\u044B\u0440\u043A\u0443
      \u043E\u0442 \u043F\u043E\u043D\u0447\u0438\u043A\u0430, \u0442\u043E \u0441\u0442\u0430\u043D\u0435\u0448\u044C
      \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u043C. \u0421\u0442\u043E\u0438\u0442
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 55463433134080
    m_Localized: "\u0423\u0440 12. \u0412\u043E\u043B\u0448\u0435\u0431\u043D\u044B\u0439
      \u043F\u043E\u043D\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 55465010192384
    m_Localized: "\u0423\u0440 13. \u0413\u0430\u043C\u0431\u0443\u0440\u0433\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 55466557890560
    m_Localized: "\u0423\u0440 14. \u041A\u0430\u0440\u0442\u043E\u0448\u043A\u0430
      \u0444\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 55468164308992
    m_Localized: "\u0423\u0440 15.  \u041D\u0430\u0447\u043E\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 55469774921728
    m_Localized: "\u0423\u0440 16. \u041F\u0438\u0446\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 55472325058560
    m_Localized: "\u0423\u0440 17. \u041A\u0443\u0440\u0438\u043D\u0430\u044F \u043D\u043E\u0436\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 55473902116864
    m_Localized: "\u0423\u0440 18. \u041C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 55475445620736
    m_Localized: "\u0423\u0440 19. \u0425\u043E\u0442 \u0434\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 55477022679040
    m_Localized: "\u0423\u0440 20. \u0422\u043E\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 55478566182912
    m_Localized: "\u0423\u0440 21. \u041E\u0432\u043E\u0449\u043D\u043E\u0439 \u043A\u0438\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 55926924697600
    m_Localized: "\u0423\u0440 22. \u0421\u0430\u043B\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 55960575598592
    m_Localized: "\u0423\u0440 23. \u041A\u0440\u0435\u0432\u0435\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 55964199477248
    m_Localized: "\u0423\u0440 24. \u0420\u043E\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 55967018049536
    m_Localized: "\u0423\u0440 25. \u0411\u043B\u0438\u043D\u0447\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 55976044191744
    m_Localized: "\u0423\u0440 26. \u0420\u0430\u043C\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 55982113349632
    m_Localized: "\u0423\u0440 27. \u0428\u043E\u043A\u043E\u043B\u0430\u0434\u043D\u044B\u0439
      \u0442\u043E\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 55988329308160
    m_Localized: "\u0423\u0440 28. \u0413\u043E\u0432\u044F\u0434\u0438\u043D\u0430
      \u0412\u0435\u043B\u043B\u0438\u043D\u0433\u0442\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 55991957381120
    m_Localized: "\u0423\u0440 29. \u041A\u0440\u0430\u0441\u043D\u0430\u044F \u0438
      \u0447\u0451\u0440\u043D\u0430\u044F \u0438\u043A\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 55998525661184
    m_Localized: "\u0423\u0440 30. \u0426\u0430\u0440\u0441\u043A\u0430\u044F \u0438\u043D\u0434\u0435\u0439\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 55465781944320
    m_Localized: "\u0412 \u043D\u0451\u043C \u0435\u0441\u0442\u044C \u043C\u044F\u0441\u043E,
      \u043E\u0432\u043E\u0449\u0438 \u0438 \u0445\u043B\u0435\u0431. \u042D\u0442\u043E
      \u0436\u0435 \u0441\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u043F\u0438\u0442\u0430\u043D\u0438\u0435! \u0414\u0438\u0435\u0442\u043E\u043B\u043E\u0433\u0438
      \u043E\u0434\u043E\u0431\u0440\u044F\u044E\u0442. \u041D\u0443, \u043C\u044B
      \u043D\u0430 \u044D\u0442\u043E \u043D\u0430\u0434\u0435\u0435\u043C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 55467321253888
    m_Localized: "\u0423 \u043D\u0430\u0441 \u043D\u043E\u0432\u0430\u044F \u0441\u0432\u0435\u0440\u0445\u0432\u0430\u0436\u043D\u0430\u044F
      \u0437\u0430\u0434\u0430\u0447\u0430. \u041D\u0430\u0434\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C
      \u043A\u0430\u0440\u0442\u043E\u0444\u0435\u043B\u044C\u043D\u0443\u044E \u043F\u0430\u043B\u043E\u0447\u043A\u0443,
      \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u0435\u0451 \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u043D\u0430\u0448\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 55468965421056
    m_Localized: "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
      \u043C\u044B \u0435\u0434\u0438\u043C, \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u043E\u0433\u0434\u0430 \u043C\u044B \u0433\u043E\u043B\u043E\u0434\u043D\u044B,
      \u043D\u043E \u0438 \u043A\u043E\u0433\u0434\u0430 \u043C\u044B \u0441\u044B\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 55470643142656
    m_Localized: "\u041C\u0438\u0440 \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439:
      \u043A\u043E\u0440\u043E\u0431\u043A\u0430 \u0434\u043B\u044F \u043F\u0438\u0446\u0446\u044B
      \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u0430\u044F, \u0441\u0430\u043C\u0430
      \u043F\u0438\u0446\u0446\u0430 \u043A\u0440\u0443\u0433\u043B\u0430\u044F,
      \u043F\u043E\u0440\u0446\u0438\u0438 \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0435,
      \u0430 \u043C\u043E\u0438 \u0448\u0443\u0442\u043A\u0438 \u043F\u043B\u043E\u0441\u043A\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 55473096810496
    m_Localized: "\u0422\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u043A\u0430\u043A\u0438\u0435 \u043D\u043E\u0436\u043A\u0438! \u0412\u0430\u0445!
      \u041A\u0440\u0430\u0441\u0438\u0432\u044B\u0435! \u0417\u0430\u0433\u043E\u0440\u0435\u043B\u044B\u0435!
      \u0411\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u0435! \u041D\u0443 \u043A\u0430\u043A
      \u043F\u0435\u0440\u0435\u0434 \u0442\u0430\u043A\u0438\u043C\u0438 \u0443\u0441\u0442\u043E\u044F\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 55474678063104
    m_Localized: "\u0427\u0442\u043E-\u0442\u043E \u0430\u0436 \u0436\u0430\u0440\u043A\u043E
      \u0441\u0442\u0430\u043B\u043E, \u043D\u0430\u0434\u043E \u0447\u0435\u043C-\u0442\u043E
      \u043E\u0445\u043B\u0430\u0434\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 55476188012544
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u0442\u0430\u043A
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E \u0441\u0442\u0430\u043B\u043E.
      \u0421\u0442\u0440\u0430\u043D\u043D\u043E. \u041D\u0430\u0434\u043E \u0447\u0435\u043C-\u0442\u043E
      \u0441\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 55477827985408
    m_Localized: "\u041C\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u0441\u0435\u0441\u0442\u044C
      \u043D\u0430 \u0434\u0438\u0435\u0442\u0443. \u041D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043D\u0443\u0436\u043D\u043E \u0434\u043E\u0435\u0441\u0442\u044C \u0432\u0441\u0451,
      \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0432
      \u0434\u043E\u043C\u0435. \u0427\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 55933631389696
    m_Localized: "\u041F\u043E\u0445\u043E\u0436\u0435 \u043F\u0440\u043E\u0448\u043B\u043E\u0435
      \u0431\u043B\u044E\u0434\u043E \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u043B\u043E
      \u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u0435\u0441, \u0437\u043D\u0430\u0447\u0438\u0442
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C \u0441\u044A\u0435\u0441\u0442\u044C
      \u0434\u0440\u0443\u0433\u043E\u0435 \u0431\u043B\u044E\u0434\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 55479371489280
    m_Localized: "\u0427\u0442\u043E\u0431\u044B \u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u0432\u0435\u0441 \u043C\u044B \u0431\u0443\u0434\u0435\u043C \u0435\u0441\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u0438\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043F\u0438\u0449\u0443! \u0412\u043E\u0442, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      \u043A\u0438\u0448. \u0421 \u0441\u044B\u0440\u043E\u043C, \u0441\u043C\u0435\u0442\u0430\u043D\u043E\u0439
      \u0438 \u0442\u0435\u0441\u0442\u043E\u043C! \u0412 \u043D\u0451\u043C \u0435\u0441\u0442\u044C
      \u0434\u0438\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0435\u0440\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 55963457085440
    m_Localized: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0435 \u0442\u0430\u043A
      \u043B\u044E\u0431\u044F\u0442 \u044D\u0442\u0438\u0445 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0445,
      \u0441\u0443\u0442\u0443\u043B\u044B\u0445 \u043D\u0435\u0434\u043E\u043B\u043E\u0431\u0441\u0442\u0435\u0440\u043E\u0432.
      \u041D\u0430\u0434\u043E \u0431\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 55966313406464
    m_Localized: "\u042D\u0442\u043E \u0436\u0435 \u0441\u043A\u043E\u0440\u043E\u043F\u043E\u0440\u0442\u044F\u0449\u0438\u0439\u0441\u044F
      \u043F\u0440\u043E\u0434\u0443\u043A\u0442. \u0422\u0430\u043A \u0447\u0442\u043E
      \u0441\u0440\u043E\u0447\u043D\u043E \u0436\u0440\u0430\u0442\u044C!!!"
    m_Metadata:
      m_Items: []
  - m_Id: 55969069064192
    m_Localized: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u044B
      \u0437\u0430\u044F\u0432\u043B\u044F\u044E\u0442, \u0447\u0442\u043E \u0432
      \u0434\u0435\u043D\u044C \u043C\u043E\u0436\u043D\u043E \u0435\u0441\u0442\u044C
      \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 2-3 \u0431\u043B\u0438\u043D\u043E\u0432.
      \u041D\u043E \u0432\u043E\u043E\u0431\u0449\u0435-\u0442\u043E 23 \u043F\u0438\u0448\u0435\u0442\u0441\u044F
      \u0441\u043B\u0438\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 55980003614720
    m_Localized: "\u042F\u043F\u043E\u043D\u0446\u044B \u0441\u0442\u0440\u043E\u0439\u043D\u044B\u0435!
      \u0418 \u042F\u043F\u043E\u043D\u0446\u044B \u0435\u0434\u044F\u0442 \u0440\u0430\u043C\u0435\u043D!
      \u0417\u043D\u0430\u0447\u0438\u0442, \u0440\u0430\u043C\u0435\u043D \u044D\u0442\u043E
      \u0438\u0445 \u0441\u0435\u043A\u0440\u0435\u0442 \u0441\u0442\u0440\u043E\u0439\u043D\u043E\u0441\u0442\u0438!
      \u041C\u044B \u043D\u0430\u0448\u043B\u0438 \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 55986479620096
    m_Localized: "\u041C\u044B \u043C\u043E\u0436\u0435\u043C \u0432\u0435\u0441\u044C
      \u0434\u0435\u043D\u044C \u043D\u0435 \u0435\u0441\u0442\u044C \u0442\u043E\u0440\u0442!
      \u0423 \u043D\u0430\u0441 \u0436\u0435\u043B\u0435\u0437\u043D\u0430\u044F
      \u0441\u0438\u043B\u0430 \u0432\u043E\u043B\u0438! \u041E! \u0410 \u0432\u043E\u0442
      \u0438 \u043D\u043E\u0447\u044C \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 55990275465216
    m_Localized: "\u042D\u0442\u043E \u0436\u0435 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043C\u044F\u0441\u043E, \u044D\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u0435
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430! \u041C\u044B \u043F\u0440\u0438\u043E\u0431\u0449\u0430\u0435\u043C\u0441\u044F
      \u043A \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u043C\u0443\u2026
      \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0436\u0443\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 55996780830720
    m_Localized: "\u041F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u044C \u0448\u0443\u0442\u043A\u0443!
      \u041D\u0435 \u0437\u0430\u0431\u044B\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 63040632053760
    m_Localized: "\u0412\u0441\u0451! \u041C\u044B \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u0441\u044B\u0442\u044B! \u0412 \u043D\u0430\u0441 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043B\u0435\u0437\u0435\u0442, \u043D\u043E \u0442\u0443\u0442
      \u041E\u041D\u0410! \u041C\u044B \u0435\u0451 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C
      \u0415\u0433\u0430\u043B\u0438\u0430\u043D\u043D\u0430 \u0418\u043D\u0434\u0435\u0439\u043A\u043E\u0432\u043D\u0430
      III! \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0431\u043E\u0441\u0441
      \u0438\u0433\u0440\u044B \u043C\u0435\u0436\u0434\u0443 \u043F\u0440\u043E\u0447\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 321847039811584
    m_Localized: "\u041D\u043E\u0432\u044B\u0435 \u0443\u0440\u043E\u0432\u043D\u0438
      \u0441\u043A\u043E\u0440\u043E"
